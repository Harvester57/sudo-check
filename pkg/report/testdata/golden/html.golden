                                    <button type="button" class="compliance-badge" data-jump-rule="SUDO-GTFO-002" title="Filter Audit Report by rule SUDO-GTFO-002">SUDO-GTFO-002</button>
                                    <button type="button" class="compliance-badge" data-jump-rule="SUDO-GTFO-003" title="Filter Audit Report by rule SUDO-GTFO-003">SUDO-GTFO-003</button>
