                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-005" title="Filter Audit Report by rule SUDO-DEF-005">SUDO-DEF-005</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-006" title="Filter Audit Report by rule SUDO-DEF-006">SUDO-DEF-006</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-007" title="Filter Audit Report by rule SUDO-DEF-007">SUDO-DEF-007</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-008" title="Filter Audit Report by rule SUDO-DEF-008">SUDO-DEF-008</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-009" title="Filter Audit Report by rule SUDO-DEF-009">SUDO-DEF-009</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-010" title="Filter Audit Report by rule SUDO-DEF-010">SUDO-DEF-010</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-011" title="Filter Audit Report by rule SUDO-DEF-011">SUDO-DEF-011</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-012" title="Filter Audit Report by rule SUDO-DEF-012">SUDO-DEF-012</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-013" title="Filter Audit Report by rule SUDO-DEF-013">SUDO-DEF-013</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-014" title="Filter Audit Report by rule SUDO-DEF-014">SUDO-DEF-014</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-015" title="Filter Audit Report by rule SUDO-DEF-015">SUDO-DEF-015</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-DEF-016" title="Filter Audit Report by rule SUDO-DEF-016">SUDO-DEF-016</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-001" title="Filter Audit Report by rule SUDO-CMD-001">SUDO-CMD-001</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-002" title="Filter Audit Report by rule SUDO-CMD-002">SUDO-CMD-002</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-003" title="Filter Audit Report by rule SUDO-CMD-003">SUDO-CMD-003</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-004" title="Filter Audit Report by rule SUDO-CMD-004">SUDO-CMD-004</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-005" title="Filter Audit Report by rule SUDO-CMD-005">SUDO-CMD-005</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-006" title="Filter Audit Report by rule SUDO-CMD-006">SUDO-CMD-006</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-007" title="Filter Audit Report by rule SUDO-CMD-007">SUDO-CMD-007</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-008" title="Filter Audit Report by rule SUDO-CMD-008">SUDO-CMD-008</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-009" title="Filter Audit Report by rule SUDO-CMD-009">SUDO-CMD-009</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-010" title="Filter Audit Report by rule SUDO-CMD-010">SUDO-CMD-010</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-011" title="Filter Audit Report by rule SUDO-CMD-011">SUDO-CMD-011</button>
                    <button type="button" class="finding-id" data-jump-rule="SUDO-CMD-012" title="Filter Audit Report by rule SUDO-CMD-012">SUDO-CMD-012</button>
