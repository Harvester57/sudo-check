                                    <button type="button" class="copy-btn" data-action="copy-code">Copy</button>
                                </div>
                                <pre tabindex="0"><code>Defaults secure_path=&#34;/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin&#34;</code></pre>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
            <article class="finding-card" id="finding-5" data-order="5" data-id="SUDO-DEF-009" data-severity="MEDIUM" data-category="POLICY" data-domain="DEFAULTS" data-file="Global Policy" data-principal="(Global / Unscoped)" data-compliance="ANSSI-BP-028-R38">
