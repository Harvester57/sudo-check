      "id": "SUDO-GTFO-001",
      "title": "Dangerous Sudo Binary allowed: find (shell)",
      "description": "The command 'find' is allowed — and can be used → to bypass sudo restrictions.",
      "severity": "CRITICAL",
      "user": "alice",
      "host": "prod-db",
      "runas": "root:root",
      "command": "/usr/bin/find",
      "context": "/etc/sudoers.d/alice",
      "line": 42,
      "remediation": "Review if 'find' requires elevated privileges.",
      "remediation_code": "# Apply NOEXEC tag in /etc/sudoers.d/alice:\nalice prod-db = (root:root) NOEXEC: /usr/bin/find /var/log -maxdepth 1",
      "exploit_poc": "sudo find . -exec /bin/sh \\; -quit",
      "compliance": [
        "ANSSI-BP-028-R40"
      ]
    },
