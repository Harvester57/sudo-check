            "sudoCheckFingerprint/v1": "20b120fa787c9adc53a0397f41b9ef4767d61280878cc44b83e3ef9b01c3fbea"
          }
        },
        {
          "ruleId": "SUDO-CMD-013",
          "message": {
            "text": "The administrator-grade rule for user(s) [%wheel] on host(s) [ALL] running as [ALL] does not specify the 'TYPE=' and 'ROLE=' options. Without an explicit SELinux type and role transition, commands executed via sudo run in the invoking user's SELinux context instead of the administrator domain.\nRemediation: Add 'TYPE=sysadm_t ROLE=sysadm_r' to the administrator rule so sudo transitions to the SELinux administrator domain (DISA STIG V-272484 / RHEL-08-010455). On hosts not running SELinux this finding is informational and can be disregarded.\nExample Fix:\n%wheel ALL = (ALL) TYPE=sysadm_t ROLE=sysadm_r ALL"
          },
