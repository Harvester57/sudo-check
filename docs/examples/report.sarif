{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "sudo-check",
          "version": "dev",
          "informationUri": "https://github.com/Harvester57/sudo-check",
          "rules": [
            {
              "id": "SUDO-CMD-002",
              "shortDescription": {
                "text": "Full Root Privileges Allowed (ALL)"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "ANSSI-BP-028 R43"
                ]
              }
            },
            {
              "id": "SUDO-CMD-004",
              "shortDescription": {
                "text": "Wildcard in Command Definition"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "ANSSI-BP-028 R43"
                ]
              }
            },
            {
              "id": "SUDO-CMD-005",
              "shortDescription": {
                "text": "Passwordless Specific Command Execution Allowed (NOPASSWD)"
              },
              "properties": {
                "security-severity": "2.5",
                "tags": [
                  "CIS-5.2.4"
                ]
              }
            },
            {
              "id": "SUDO-CMD-007",
              "shortDescription": {
                "text": "Direct Text Editor Execution via Sudo"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "ANSSI-BP-028 R44"
                ]
              }
            },
            {
              "id": "SUDO-CMD-009",
              "shortDescription": {
                "text": "Dangerous Per-Command Option or Tag"
              },
              "properties": {
                "security-severity": "7.5"
              }
            },
            {
              "id": "SUDO-CMD-013",
              "shortDescription": {
                "text": "Missing or Incomplete SELinux Context Elevation on Administrator Rule"
              },
              "properties": {
                "security-severity": "1.0",
                "tags": [
                  "DISA-STIG"
                ]
              }
            },
            {
              "id": "SUDO-CMD-015",
              "shortDescription": {
                "text": "Shadowed or Overridden Sudoers Rule"
              },
              "properties": {
                "security-severity": "5.0"
              }
            },
            {
              "id": "SUDO-DEF-002",
              "shortDescription": {
                "text": "Dangerous Path in secure_path Configuration"
              },
              "properties": {
                "security-severity": "7.5"
              }
            },
            {
              "id": "SUDO-DEF-003",
              "shortDescription": {
                "text": "Missing or Disabled use_pty"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "ANSSI-BP-028 R39",
                  "CIS-5.2.2"
                ]
              }
            },
            {
              "id": "SUDO-DEF-004",
              "shortDescription": {
                "text": "Dangerous Environment Variables Preserved (env_keep / env_check)"
              },
              "properties": {
                "security-severity": "9.0"
              }
            },
            {
              "id": "SUDO-DEF-005",
              "shortDescription": {
                "text": "visiblepw Flag Enabled"
              },
              "properties": {
                "security-severity": "7.5"
              }
            },
            {
              "id": "SUDO-DEF-007",
              "shortDescription": {
                "text": "Missing or Disabled noexec"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "ANSSI-BP-028 R39"
                ]
              }
            },
            {
              "id": "SUDO-DEF-008",
              "shortDescription": {
                "text": "Missing or Disabled requiretty"
              },
              "properties": {
                "security-severity": "2.5",
                "tags": [
                  "ANSSI-BP-028 R39"
                ]
              }
            },
            {
              "id": "SUDO-DEF-009",
              "shortDescription": {
                "text": "Missing or Weak umask Configuration"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "ANSSI-BP-028 R39"
                ]
              }
            },
            {
              "id": "SUDO-DEF-010",
              "shortDescription": {
                "text": "Missing or Disabled ignore_dot"
              },
              "properties": {
                "security-severity": "5.0",
                "tags": [
                  "ANSSI-BP-028 R39"
                ]
              }
            },
            {
              "id": "SUDO-DEF-012",
              "shortDescription": {
                "text": "Password Authentication Disabled (!authenticate)"
              },
              "properties": {
                "security-severity": "9.0",
                "tags": [
                  "CIS-5.2.5"
                ]
              }
            },
            {
              "id": "SUDO-DEF-017",
              "shortDescription": {
                "text": "Missing or Disabled Sudo Log File (logfile)"
              },
              "properties": {
                "security-severity": "2.5",
                "tags": [
                  "CIS-5.2.3"
                ]
              }
            },
            {
              "id": "SUDO-GTFO-001",
              "shortDescription": {
                "text": "Permitted Binary in GTFObins Catalog"
              },
              "properties": {
                "security-severity": "7.5",
                "tags": [
                  "MITRE-T1548.003"
                ]
              }
            },
            {
              "id": "SUDO-GTFO-002",
              "shortDescription": {
                "text": "Passwordless Permitted Binary in GTFObins Catalog"
              },
              "properties": {
                "security-severity": "9.0",
                "tags": [
                  "MITRE-T1548.003"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SUDO-DEF-004",
          "message": {
            "text": "The policy explicitly preserves dangerous environment variables: LD_PRELOAD. This can allow local users to alter runtime linker behavior, interpreter module paths, or pager/editor execution in elevated processes.\nRemediation: Remove dynamic library path, interpreter path, and shell/editor environment variables from 'env_keep' and 'env_check', and keep them in 'env_delete' in sudoers Defaults.\nExample Fix:\nDefaults env_keep -= \"LD_PRELOAD\""
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/examples/policy/sudoers"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sudoCheckFingerprint/v1": "5a7de504c94d9577d19deba7c4c5d52fa0f01214ede67d624b9e5739867a67be"
          }
        },
        {
          "ruleId": "SUDO-GTFO-002",
          "message": {
            "text": "The user(s) [deploy] can run '/usr/bin/systemctl restart nginx.service' via sudo as [root] without a password (NOPASSWD) with the 'command' capability (inherited via less). This can enable privilege escalation if the inherited 'less' behavior can be triggered.\nGTFObins Context: Inherits command behavior from less.\nNote: Pager escape requires a TTY with paged output and is typically restricted on systemd \u003e= 247 (LESSSECURE=1 under sudo) unless PAGER/SYSTEMD_PAGER/LESSSECURE is preserved or overridden.\nNote: Environment-variable techniques (e.g. LESSOPEN/VISUAL/EDITOR) require SETENV or matching env_keep permissions.\nRemediation: Remove this binary from sudoers or replace it with a tightly scoped wrapper script.\nExample Fix:\n# Replace direct 'systemctl' (command) access with a root-owned wrapper script (EXEC: required when global Defaults noexec is active):\ndeploy ALL = (root) PASSWD: EXEC: sha256:\u003cdigest\u003e /usr/local/sbin/safe-systemctl-wrapper.sh \"\""
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/examples/policy/sudoers.d/10-deploy"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sudoCheckFingerprint/v1": "6cf2f6a0a19e806fcd68ecbb80635792c6c6220e5f2a37ec7e16137993295a7b"
          }
        },
        {
          "ruleId": "SUDO-GTFO-002",
          "message": {
            "text": "The user(s) [deploy] can run '/usr/bin/systemctl restart nginx.service' via sudo as [root] without a password (NOPASSWD) with the 'file-read' capability (inherited via less). This can enable privilege escalation if the inherited 'less' behavior can be triggered.\nGTFObins Context: Inherits file-read behavior from less (and transitively via less -\u003e vi).\nNote: Pager escape requires a TTY with paged output and is typically restricted on systemd \u003e= 247 (LESSSECURE=1 under sudo) unless PAGER/SYSTEMD_PAGER/LESSSECURE is preserved or overridden.\nLaunching 'vi' from piped 'less' output requires opening a file first (e.g. ':e /path/to/file' then 'v').\nNote: Environment-variable techniques (e.g. LESSOPEN/VISUAL/EDITOR) require SETENV or matching env_keep permissions.\nThis can be used to read another file, e.g., when invoked as a pager with some fixed content.\nThis can be used to read another file.\nRemediation: Remove this binary from sudoers or replace it with a tightly scoped wrapper script.\nExample Fix:\n# Replace direct 'systemctl' (file-read) access with a root-owned wrapper script (EXEC: required when global Defaults noexec is active):\ndeploy ALL = (root) PASSWD: EXEC: sha256:\u003cdigest\u003e /usr/local/sbin/safe-systemctl-wrapper.sh \"\""
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/examples/policy/sudoers.d/10-deploy"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "sudoCheckFingerprint/v1": "b5b84e6684e429db01525cf705e232616be9eac8a0ea16ff8f7696f398b36f10"
          }
        },
